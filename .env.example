APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=recrutement
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Recrutement MSHP
INVITATION_TOKEN_VALIDITY_DAYS=7
UPLOAD_MAX_SIZE_KB=5120
RECRUTEMENT_STORAGE_DISK=private

# Déploiement cPanel via bash deploy.sh (installation existante uniquement).
# Cible MySQL observée : SELECT DATABASE(), @@server_uuid;
# Ces valeurs sont contrôlées même si la configuration Laravel est en cache.
# DEPLOY_DB_DATABASE=
# DEPLOY_DB_SERVER_UUID=
# Référence d'une sauvegarde réalisée et vérifiée par l'opérateur avant déploiement.
# Le script ne crée ni ne restaure de sauvegarde.
# DEPLOY_BACKUP_REFERENCE=
# À définir uniquement après arrêt des workers, crons et autres écritures.
# Leur reprise reste à la charge de l'opérateur après succès du déploiement.
# DEPLOY_WRITERS_STOPPED=1
# L'aperçu SQL est indicatif. Chaque requête réelle sensible exige une confirmation
# interactive liée à la cible, à la révision et au SQL, avant son exécution.
# Les écritures qualifiées hors de la base vérifiée ou ambiguës sont refusées.
